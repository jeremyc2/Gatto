import { setNotificationPopover, expireNotification } from "../notification-browser"
import pure { focusRemainsInside } from "../notification-browser"
import pure { attrs } from "@stylexjs/stylex"
import pure { styles } from "./SiteNotifications.stylex"

/** One notice, with pause and disposal controlled by the owning region. */
export component SiteNotifications(props: {
  open: boolean;
  trigger: HTMLButtonElement | undefined;
  onDismiss: () => void;
}) {
  source region: HTMLDivElement | undefined := undefined
  source hovered := false
  source focused := false
  running = props.open && !hovered && !focused

  action captureRegion(element: HTMLDivElement) { region := element }

  effect (region, props.open) {
    let element = $0
    if (!element) return
    setNotificationPopover(element, $1)
    return () => { setNotificationPopover(element, false) }
  }

  effect (running) {
    if (!$0) return
    return expireNotification(() => { props.onDismiss() })
  }

  action dismiss() {
    hovered := false
    focused := false
    props.onDismiss()
    props.trigger?.focus({ preventScroll: true })
  }

  <div
    ref={captureRegion}
    {...attrs(styles.region)}
    id="site-notifications"
    popover="manual"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    {if props.open {
      <div
        {...attrs(styles.notice)}
        onMouseEnter={() => { hovered := true }}
        onMouseLeave={() => { hovered := false }}
        onFocusIn={() => { focused := true }}
        onFocusOut={(event) => {
          focused := focusRemainsInside(event)
        }}
      >
        <span>Gattoverse mini game coming soon.</span>
        <button
          {...attrs(styles.close)}
          type="button"
          aria-label="Dismiss notification"
          onClick={() => { dismiss() }}
        >✖</button>
      </div>
    }}
  </div>
}
