import pure { attrs } from "@stylexjs/stylex"
import pure { styles } from "./PortalSeam.stylex"
import pure seam from "../../assets/images/portal-seam.svg"
import pure complement from "../../assets/images/portal-seam-complement.svg"

export component PortalSeam(props: { edge: "top" | "bottom" }) {
  <div
    aria-hidden="true"
    {...attrs(styles.edge, props.edge === "top" ? styles.top : styles.bottom)}
    style={{ "--portal-seam": `url(${props.edge === "top" ? complement : seam})` }}
  >
    <div
      {...attrs(styles.material, styles.paper, props.edge === "top" && styles.clearTop)}
    />
    <div
      {...attrs(
        styles.material,
        props.edge === "top" ? styles.footer : styles.download,
        props.edge === "top" ? styles.faceTop : styles.faceBottom,
        props.edge === "top" && styles.clearTop,
      )}
    />
  </div>
}
