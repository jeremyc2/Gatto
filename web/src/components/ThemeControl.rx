import pure { attrs } from "@stylexjs/stylex"
import pure { themeOptions } from "../theme"
import { observeTheme, setTheme } from "../theme"
import pure { styles } from "./ThemeControl.stylex"

type ThemePreference = import("../theme").ThemePreference

export component ThemeControl() {
  source choice: ThemePreference := "system"
  effect () {
    return observeTheme(value => { choice := value })
  }

  action select(value: ThemePreference) {
    choice := value
    setTheme(value)
  }

  <fieldset {...attrs(styles.group)} aria-label="Color scheme">
    {for option in themeOptions {
      <label {...attrs(styles.option, option === choice && styles.selected)}>
        <input
          {...attrs(styles.input)}
          type="radio"
          name="gatto-theme"
          value={option}
          aria-label={option === "system" ? "System" : option === "light" ? "Light" : "Dark"}
          checked={option === choice}
          onChange={() => select(option)}
        />
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {if option === "system" {
            <path d="M2.3 3.5h11.4v7.7H2.3zM5.4 13.4h5.2M8 11.2v2.2" />
          } else if option === "light" {
            <circle cx="8" cy="8" r="2.7" />
            <path d="M8 1.3v1.3m0 10.8v1.3m6.7-6.7h-1.3M2.6 8H1.3m11.4-4.7-.9.9m-7.6 7.6-.9.9m9.4 0-.9-.9M4.2 4.2l-.9-.9" />
          } else {
            <path d="M13.7 10.2A6 6 0 0 1 5.8 2.3a6 6 0 1 0 7.9 7.9Z" />
          }}
        </svg>
      </label>
    }}
  </fieldset>
}
