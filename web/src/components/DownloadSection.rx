import pure { attrs } from "@stylexjs/stylex"
import pure { styles } from "./DownloadSection.stylex"
import { Container } from "../design-system/Container.rx"
import { Heading, Text } from "../design-system/Typography.rx"
import { Link } from "../design-system/Link.rx"
import { DownloadBadge } from "../DownloadBadge.rx"
import { PortalSeam } from "./PortalSeam.rx"

export component DownloadSection() {
  <section {...attrs(styles.downloadSection)} id="download">
    <Container xstyle={styles.downloadRow}>
      <div>
        <Heading size="title" xstyle={styles.downloadHeading}>
          Free.
          <br />
          Open source.
        </Heading>
        <Text size="small" muted xstyle={styles.requirements}>
          Apple Silicon · macOS 13 or later
          <br />
          GitHub CLI required.{" "}
          <Link href="https://github.com/jeremyc2/Gatto/blob/main/docs/SETUP.md">
            Setup guide
          </Link>
        </Text>
      </div>
      <div {...attrs(styles.action)}>
        <DownloadBadge placement="footer" />
      </div>
    </Container>
    <PortalSeam edge="bottom" />
  </section>
}
