import { Story } from "./Story.rx"
import { SiteHeader } from "./components/SiteHeader.rx"
import { Features } from "./components/Features.rx"
import { DownloadSection } from "./components/DownloadSection.rx"
import { PortalEnding } from "./components/PortalCat.rx"
import { SiteNotifications } from "./components/SiteNotifications.rx"

export default component App() {
  source notificationVisible := false
  source header: HTMLElement | undefined := undefined
  source portalTrigger: HTMLButtonElement | undefined := undefined

  action captureHeader(element: HTMLElement | undefined) { header := element }
  action capturePortal(element: HTMLButtonElement | undefined) { portalTrigger := element }

  <SiteHeader ref={captureHeader} />
  <main>
    <Story header={header} />
    <Features />
    <DownloadSection />
  </main>
  <PortalEnding portalRef={capturePortal} onActivate={() => { notificationVisible := true }} />
  <SiteNotifications
    open={notificationVisible}
    trigger={portalTrigger}
    onDismiss={() => { notificationVisible := false }}
  />
}
